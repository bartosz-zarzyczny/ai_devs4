import json, urllib.parse, urllib.request, math, time
from pathlib import Path
base=Path('L02')
plants=json.loads((base/'plant.json').read_text(encoding='utf-8'))['power_plants']
people=json.loads((base/'locations.json').read_text(encoding='utf-8'))

def geocode(city):
 q=urllib.parse.urlencode({'q':f'{city}, Poland','format':'json','limit':1})
 url='https://nominatim.openstreetmap.org/search?'+q
 req=urllib.request.Request(url,headers={'User-Agent':'ai_devs4-script'})
 with urllib.request.urlopen(req,timeout=30) as r:
  arr=json.loads(r.read().decode('utf-8'))
 if not arr: return None
 return float(arr[0]['lat']), float(arr[0]['lon'])

coords={}
for city in plants:
 c=geocode(city)
 coords[city]=c
 time.sleep(1)
print('plant coords',coords)

R=6371.0
def hav(a,b,c,d):
 p1,p2=math.radians(a),math.radians(c)
 dp=math.radians(c-a);dl=math.radians(d-b)
 x=math.sin(dp/2)**2+math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2
 return 2*R*math.atan2(math.sqrt(x),math.sqrt(1-x))

